# ── LLM provider ──────────────────────────────────────────
LLM_PROVIDER=anthropic          # "anthropic" or "openai"
ANTHROPIC_API_KEY=sk-ant-...    # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=sk-...           # required when LLM_PROVIDER=openai

# ── Existing module API keys ───────────────────────────────
CRYPTOPANIC_API_KEY=your_key_here
NEWSAPI_KEY=your_key_here
TWITTER_BEARER_TOKEN=your_key_here

# ── Storage paths (defaults work out of the box) ──────────
CHROMA_DB_PATH=./data/chroma
SQLITE_DB_PATH=./data/alpha_seeker_memory.db
CHECKPOINT_DB_PATH=./data/alpha_seeker_checkpoints.db

# ── Behaviour ─────────────────────────────────────────────
RAG_REFRESH_HOURS=6
ANALYSIS_CACHE_MINUTES=15
MAX_DEBATE_ROUNDS=2
