# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=optional

# News (free tier: 100 req/day — https://newsapi.org)
NEWSAPI_KEY=

# Fundamental data (free registration required)
# USDA: https://quickstats.nass.usda.gov/api
USDA_API_KEY=
# EIA: https://www.eia.gov/opendata/
EIA_API_KEY=

# Storage paths
CHROMA_DB_PATH=./data/chroma
HISTORICAL_EVENTS_PATH=./rag/historical_events.json

# Analysis settings
RAG_REFRESH_ON_ANALYSIS=true
MAX_DEBATE_ROUNDS=2
SYNTHESIS_MODEL_OVERRIDE=true
